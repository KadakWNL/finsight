      "css": ".ds-panel{background:var(--surface,#ffffff);color:var(--foreground,#0f0f0f);border:1px solid var(--border,#dedede);border-radius:8px;overflow:hidden;font-family:var(--font-plex,'IBM Plex Sans'),'Segoe UI',system-ui,sans-serif;}.ds-panel-heading{padding:20px 24px;border-bottom:1px solid var(--border,#dedede);}.ds-panel h2{margin:0;font-size:18px;font-weight:650;line-height:1.4;}"
