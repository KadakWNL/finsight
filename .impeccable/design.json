      "html": "<button class=\"ds-secondary\" type=\"button\">Cancel</button>",
      "css": ".ds-secondary{display:inline-flex;min-height:44px;align-items:center;justify-content:center;border:0;border-radius:0.375rem;padding:8px 16px;font-size:14px;line-height:20px;font-weight:500;cursor:pointer;font-family:var(--font-plex,'IBM Plex Sans'),'Segoe UI',system-ui,sans-serif;background:var(--surface,#ffffff);color:var(--foreground,#0f0f0f);border:1px solid var(--border,#dedede);}.ds-secondary:hover{background:var(--surface-hover,#e5e5e5);}.ds-secondary:focus-visible{outline:2px solid var(--ring,#7c3aed);outline-offset:2px;}.ds-secondary:disabled{pointer-events:none;opacity:.5;}"
    },
    {
      "name": "Reason field",
      "kind": "input",
      "refersTo": "input",
      "description": "Case reason textarea with shared field styling.",
      "html": "<label class=\"ds-label\" for=\"ds-reason\">Reason</label><textarea class=\"ds-input\" id=\"ds-reason\" rows=\"5\" maxlength=\"2000\" required></textarea>",
      "css": ".ds-label{display:block;font-size:13px;font-weight:600;margin-bottom:6px;font-family:var(--font-plex,'IBM Plex Sans'),'Segoe UI',system-ui,sans-serif;}.ds-input{width:100%;min-height:120px;resize:vertical;border:1px solid var(--control-border,#898989);border-radius:5px;background:var(--surface,#ffffff);color:var(--foreground,#0f0f0f);padding:10px 12px;font-size:15px;line-height:1.5;caret-color:var(--primary,#7c3aed);font-family:var(--font-plex,'IBM Plex Sans'),'Segoe UI',system-ui,sans-serif;}.ds-input:focus-visible{outline:2px solid var(--ring,#7c3aed);outline-offset:3px;}.ds-input:disabled{background:var(--surface-muted,#f2f2f2);}"
    },
    {
      "name": "Sidebar selection",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Square active overview link with the implemented icon and focus treatment.",
      "html": "<nav aria-label=\"Primary navigation\"><a class=\"ds-nav\" href=\"/overview\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M4 10h16M10 10v10\"/></svg> Overview</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 12px;border:0;border-radius:0;box-shadow:none;color:var(--secondary-text,#606060);font-size:14px;font-weight:500;text-decoration:none;font-family:var(--font-plex,'IBM Plex Sans'),'Segoe UI',system-ui,sans-serif;}.ds-nav:hover{background:var(--surface-muted,#f2f2f2);color:var(--foreground,#0f0f0f);}.ds-nav[aria-current=page]{background:var(--selection,#e5e5e5);color:var(--foreground,#0f0f0f);font-weight:600;}.ds-nav:focus-visible{outline:2px solid var(--ring,#7c3aed);outline-offset:3px;} .ds-nav[aria-current=page] svg{color:var(--primary,#7c3aed);}"
    },
