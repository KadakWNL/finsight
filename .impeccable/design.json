  "narrative": {
    "northStar": "",
    "overview": "This design record describes the implemented UI in [globals.css](src/app/globals.css), [layout.tsx](src/app/layout.tsx), and the [workspace shell](src/components/workspace/app-shell.tsx). The user accepted this visual direction on 2026-10-27; its scope is recorded in [PRODUCT.md](PRODUCT.md#user-commitments).\n\nThe transaction workspace uses violet accents, bordered work panels and a persistent desktop sidebar. Light and dark modes share layout and component shapes. No brand metaphor has been established.",
    "keyCharacteristics": [
      "Square active sidebar items with a filled selection surface.",
      "Theme-aware neutral surfaces with violet action and focus colors.",
      "Tables, masked context and recorded evidence lead the workspace.",
      "IBM Plex Sans supplies the shared text family."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Use the semantic CSS properties so a surface, its text and its border change together across themes.",
        "section": "colors"
      },
      {
        "name": "The Square Selection Rule",
        "body": "Keep the sidebar and its square active item surface. Do not add a curved left active marker, a pill shape or an active-item shadow.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do retain the desktop sidebar and the mobile menu for the implemented destinations.",
      "Do use semantic theme properties for component colors.",
      "Do retain visible keyboard focus and written risk labels.",
      "Do preserve scrollable tables and access to full identifiers."
    ],
    "donts": [
      "Don't add a curved left active marker or rounded active navigation items.",
      "Don't treat a risk color as a fraud verdict.",
      "Don't treat visual acceptance as proof of accessibility or workflow acceptance."
    ]
  }
}
