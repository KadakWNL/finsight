      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action from Button; no distinct hover color is defined.",
      "html": "<button class=\"ds-primary\" type=\"button\">Create case</button>",
      "css": ".ds-primary{display:inline-flex;min-height:44px;align-items:center;justify-content:center;border:0;border-radius:0.375rem;padding:8px 16px;font-size:14px;line-height:20px;font-weight:500;cursor:pointer;font-family:var(--font-plex,'IBM Plex Sans'),'Segoe UI',system-ui,sans-serif;background:var(--primary,#7c3aed);color:var(--primary-foreground,#ffffff);}.ds-primary:focus-visible{outline:2px solid var(--ring,#7c3aed);outline-offset:2px;}.ds-primary:disabled{pointer-events:none;opacity:.5;}"
    },
