      "css": ".ds-theme{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:44px;height:44px;color:var(--secondary-text,#606060);border:1px solid var(--border,#dedede);border-radius:5px;background:var(--surface,#ffffff);cursor:pointer;}.ds-theme:hover{background:var(--surface-hover,#e5e5e5);color:var(--foreground,#0f0f0f);}.ds-theme:focus-visible{outline:2px solid var(--ring,#7c3aed);outline-offset:3px;}"
    }
