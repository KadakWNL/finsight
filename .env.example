# Copy to .env.local. Supply local credentials; never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=postgresql://finsight_app:REPLACE_ME@localhost:5432/finsight_demo
SERVICE_DATABASE_URL=postgresql://finsight_service:REPLACE_ME@localhost:5432/finsight_demo
MIGRATOR_DATABASE_URL=postgresql://finsight_migrator:REPLACE_ME@localhost:5432/finsight_demo
TEST_DATABASE_URL=postgresql://finsight_test:REPLACE_ME@localhost:5432/finsight_test
ACCEPTANCE_RUNTIME_DATABASE_URL=postgresql://finsight_runtime:REPLACE_ME@localhost:5432/finsight_test
# Explicit opt-in for migration/integration tests against an isolated local database.
ALLOW_TEST_DATABASE=false
# Local synthetic demo seed opt-in; never use real customer data.
ALLOW_SYNTHETIC_SEED=false
AUTH_SECRET=
# Canonical browser origin when running behind a reverse proxy.
NEXTAUTH_URL=http://localhost:3014
# Optional MongoDB connection for device telemetry reads and aggregation.
# When omitted or unreachable, telemetry degrades cleanly without impacting relational transaction/case workflows.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=finsight
