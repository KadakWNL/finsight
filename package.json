{
  "name": "finsight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test",
    "test:discovery": "vitest list && playwright test --list",
    "test:acceptance": "node scripts/pending.mjs acceptance",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:test": "node --env-file-if-exists=.env.local scripts/migrate.mjs --test",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "demo:fx": "node --env-file-if-exists=.env.local scripts/demo-cli.mjs fx",
    "demo:import": "node --env-file-if-exists=.env.local scripts/demo-cli.mjs import",
    "auth:provision": "node --env-file-if-exists=.env.local scripts/provision-identities.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
